# Copia este archivo a .env.local (no se sube al repositorio) y rellena los
# valores. En producción defínelos en el panel del hosting (Netlify / Vercel).
# Todas las variables VITE_* terminan incrustadas en el bundle público.

# Datos de contacto que se muestran en la web. Obligatorios para `pnpm build`.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Buzón que recibe los formularios (FormSubmit). Si se deja vacío se usa
# VITE_CONTACT_EMAIL. Útil para probar con otro correo en desarrollo.
VITE_FORM_RECIPIENT_EMAIL=

# Muestra la ruta /admin/agent (editor local de datos del agente). Solo en dev.
VITE_ENABLE_AGENT_ADMIN=false

# Sanity CMS — déjalas vacías para usar el contenido estático de src/data/content.ts
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
